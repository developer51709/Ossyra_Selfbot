modules = ["nodejs-20"]

[agent]
expertMode = true

[workflows]

[[workflows.workflow]]
name = "Run the self-bot"
mode = "sequential"
author = 39822750

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash run.sh"

[[workflows.workflow]]
name = "Install dependencies"
mode = "sequential"
author = 39822750

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash install.sh"
